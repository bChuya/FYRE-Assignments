#blinking program
#incorporate modules
#make the led objects
#infinite loop

import machine
import time

led = machine.Pin(0, machine.Pin.OUT)
#makes led an ibject
#Green LED is GPIO Pin 0

while True:
  led.value(1) # turn on :O
  time.sleep(0.25) #delay
  led.value(0) #turn off led
  time.sleep(0.25) #delay

